# ClauseGuard web (Next.js)
# Local API (uvicorn or Docker Compose). For Vercel, set this to the public Render URL
# with no trailing slash, e.g. https://clauseguard-api.onrender.com
# NEXT_PUBLIC_* is baked in at build time — change it, then rebuild/redeploy.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
